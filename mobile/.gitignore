node_modules/
.expo/
# Generated by `expo prebuild` and scripts/icons.py; never committed (tools/build.py --check bans images).
# Anchored, so modules/*/android/ (our own native code) is kept.
/android/
/ios/
modules/*/android/build/
assets/generated/
*.apk
*.aab
# EXPO_PUBLIC_* values are baked into builds; keep local overrides out of the repo and out of EAS uploads.
.env*
